# Copie os valores para um arquivo .env (que o Next.js E o Prisma CLI leem).
# NUNCA versione valores reais. O .env está no .gitignore.
#
# Adicionadas conforme as tarefas as exigirem:
# - Tarefa 013 (ADR-005/006 aprovadas): MIGRATE_DATABASE_URL e DATABASE_URL
# - Tarefa 015 (decisão A): STORAGE_DIR (opcional; padrão: storage)
# - Autenticação (017) e tempo real (038): pendentes

# Runtime e testes: role de aplicação SEM BYPASSRLS (obrigatório para o RLS
# funcionar — o owner do Neon ignora RLS mesmo com FORCE).
DATABASE_URL="postgresql://painel_app:PASSWORD@HOST/DATABASE?sslmode=require"

# Somente Prisma CLI (migrações): role dono das tabelas.
MIGRATE_DATABASE_URL="postgresql://neondb_owner:PASSWORD@HOST/DATABASE?sslmode=require"

# Base do armazenamento local de arquivos (logo; mídia na Tarefa 043).
# Caminho relativo à raiz do projeto ou absoluto; fica fora do Git.
# STORAGE_DIR="storage"
